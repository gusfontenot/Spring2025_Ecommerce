<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.eCommerce.Views.TaxRateView"
             Title="TaxRateView">
    <VerticalStackLayout>
        <Label Text="Sales Tax Rate (%): "/>
        <Entry Text="{Binding RatePercent}" Keyboard="Numeric"/>
        <Button Text="Save Changes" Clicked="SaveClicked"/>
    </VerticalStackLayout>
</ContentPage>